{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TController",
  "version": "0.1.0",
  "identifier": "com.autotitrator.tcontroller",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui-next"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../ui-next"
    },
    "devUrl": "http://localhost:3000",
    "frontendDist": "../ui-next/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AutoTitrator — TController",
        "width": 1360,
        "height": 920,
        "minWidth": 1120,
        "minHeight": 760,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
